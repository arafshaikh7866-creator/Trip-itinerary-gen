{
  "name": "trip-itinerary-gen",
  "version": "1.0.0",
  "description": "Turn a simple JSON trip file into a polished, branded travel itinerary document (.docx).",
  "main": "src/generate.js",
  "bin": {
    "trip-itinerary-gen": "src/generate.js"
  },
  "scripts": {
    "start": "node src/generate.js",
    "example": "node src/generate.js examples/sample-trip.json"
  },
  "keywords": [
